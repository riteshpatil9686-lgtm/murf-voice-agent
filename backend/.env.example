# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# PostgreSQL — Learner Memory (optional but recommended)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Examples:
#   Local:    DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/deutschmate
#   Neon:     DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/deutschmate?sslmode=require
#   Supabase: DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# Leave blank to run the agent without persistent memory.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/deutschmate

# -----------------------------------------------------------------------------
# German Language API Key — Day 5 Learning Data Source
# Base URL: https://german-language.onrender.com
# Default dev key: demo-key-12345
# -----------------------------------------------------------------------------
GERMAN_API_KEY=demo-key-12345

# -----------------------------------------------------------------------------
# Day 6 — Outbound SIP Calling via Linphone (VoiceForBharat challenge)
#
# SIP_OUTBOUND_TRUNK_ID is required to trigger Daily German Practice Calls.
# Steps to obtain it:
#   1. Create a LiveKit Cloud account at https://cloud.livekit.io/
#   2. Navigate to SIP → Outbound Trunks → Create Trunk.
#   3. Configure your SIP provider (address, username, password).
#      For Linphone (testing): the hosted domain is sip.linphone.org
#      Register a free account at https://www.linphone.org/
#   4. Copy the generated Trunk ID (format: ST_xxxxxxxxxxxx).
#
# Leave blank if you are not using the outbound calling feature.
# The agent will still work normally for inbound web sessions.
# -----------------------------------------------------------------------------
SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id_here
