# =============================================================================
# Frontend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport — must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch (optional)
# Leave blank for automatic dispatch; set to agent name for explicit dispatch.
# See https://docs.livekit.io/agents/server/agent-dispatch
# -----------------------------------------------------------------------------
AGENT_NAME=

# -----------------------------------------------------------------------------
# Optional — LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=

# -----------------------------------------------------------------------------
# Google OAuth — for learner identity (Google Sign-In)
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# 4. Copy Client ID and Client Secret below
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# NextAuth.js — secret used to sign session JWTs
# Generate with: openssl rand -base64 32
# (or any random 32+ character string)
# -----------------------------------------------------------------------------
AUTH_SECRET=your_nextauth_secret_here
